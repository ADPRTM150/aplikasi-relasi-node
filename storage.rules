rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // 📸 CHALLENGE_PROOFS — foto bukti tantangan harian
    //    Owner upload (gambar saja, maks 5MB), semua user auth
    //    boleh baca (untuk timeline pasangan)
    // ============================================================
    match /challenge_proofs/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ============================================================
    // 🚫 DEFAULT: Tolak semua
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
